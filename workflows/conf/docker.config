// Per-process container images for the `docker` profile.
// Built locally from workflows/containers/*.Dockerfile; not published to a
// registry by this change.
process {
    withName: 'QUALITY_CONTROL' {
        container = 'genomics-accelerator/secondary-pipeline-qc:local'
    }
    withName: 'ALIGN_READS' {
        container = 'genomics-accelerator/secondary-pipeline-alignment:local'
    }
    withName: 'CALL_VARIANTS' {
        container = 'genomics-accelerator/secondary-pipeline-variant-calling:local'
    }
}