def slurmPartition = System.getenv('SLURM_PARTITION') ?: 'debug'
def slurmAccount = System.getenv('SLURM_ACCOUNT')
def lustreWorkDir = System.getenv('SLURM_LUSTRE_WORKDIR')

if (!lustreWorkDir) {
    throw new IllegalStateException(
        'SLURM_LUSTRE_WORKDIR is required; the Slurm profile must use explicitly mounted campaign scratch.'
    )
}

process {
    executor = 'slurm'
    queue = slurmPartition
    clusterOptions = slurmAccount ? "--account=${slurmAccount}" : ''
    cpus = 2
    memory = '4 GB'
    time = '30m'
}

docker.enabled = false
workDir = lustreWorkDir