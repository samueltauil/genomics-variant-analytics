// Slurm executor profile: configuration preparation only.
//
// Credential-free by construction: no storage key or connection string
// appears in this file. Scratch I/O against Azure Managed Lustre (hydrated
// from blob by HSM import, exported on completion) is a separate,
// not-yet-exercised concern tracked as task 5.3; this profile only wires the
// Slurm executor and job resource requests.
//
// This profile is not exercised against a live Slurm cluster in this change
// (out of the authorized local/containerized scope); it documents the
// executor wiring so a customer's existing HPC cluster can run this
// pipeline without rewriting it.
process {
    executor = 'slurm'
    queue = '<slurm-partition>'
    clusterOptions = '--account=<slurm-account>'
    cpus = 2
    memory = '4 GB'
    time = '30m'
}