process {
    executor = 'azurebatch'
    queue = System.getenv('AZURE_BATCH_POOL_NAME')

    withName: 'STAGE_INPUT_BUNDLE' {
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-demo-sample:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
    withName: 'GENERATE_DEMO_SAMPLE' {
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-demo-sample:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
    withName: 'QUALITY_CONTROL' {
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-qc:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
    withName: 'ALIGN_READS' {
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-alignment:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
    withName: 'CALL_VARIANTS' {
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-variant-calling:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
    withName: 'PUBLISH_RESULTS' {
        // Trivial no-op process (`true`); any already-pulled stage image
        // satisfies it without requiring a dedicated container build.
        container = "${System.getenv('AZURE_BATCH_ACR_LOGIN_SERVER')}/secondary-pipeline-variant-calling:${System.getenv('AZURE_BATCH_IMAGE_TAG') ?: 'latest'}"
    }
}

workDir = "az://${System.getenv('AZURE_BATCH_WORK_CONTAINER')}/nextflow-work"

azure {
    managedIdentity {
        clientId = System.getenv('AZURE_BATCH_IDENTITY_CLIENT_ID')
    }
    storage {
        accountName = System.getenv('AZURE_BATCH_STORAGE_ACCOUNT')
    }
    batch {
        location = System.getenv('AZURE_BATCH_LOCATION')
        accountName = System.getenv('AZURE_BATCH_ACCOUNT_NAME')
        endpoint = System.getenv('AZURE_BATCH_ACCOUNT_ENDPOINT')
        poolIdentityClientId = System.getenv('AZURE_BATCH_IDENTITY_CLIENT_ID')
        autoPoolMode = false
        allowPoolCreation = false
        terminateJobsOnCompletion = true
        deleteTasksOnCompletion = false
    }
}