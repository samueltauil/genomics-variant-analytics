// Azure Batch executor profile: configuration preparation only.
//
// Credential-free by construction: no storage account key, SAS token, or
// connection string appears anywhere in this file. Storage access from the
// Batch pool is expected to be granted through the pool's user-assigned
// managed identity and Azure RBAC, configured at pool-creation time outside
// this repository (Azure Batch does not accept a managed identity inside a
// Nextflow config value; it is a pool property).
//
// This profile is not exercised against a live Batch pool in this change
// (out of the authorized local/containerized scope); it documents the
// executor wiring so a customer's existing Batch pool can be pointed at
// this pipeline without rewriting it.
process {
    executor = 'azurebatch'
}

azure {
    storage {
        // Deliberately empty: no account name/key/SAS/connection string.
        // A managed-identity-enabled Batch pool authenticates to the
        // configured storage account without one.
    }
    batch {
        location = '<azure-region>'
        accountName = '<batch-account-name>'
        autoPoolMode = false
        allowPoolCreation = false
        pools {
            'secondary-analysis-pool' {
                vmType = '<vm-sku>'
                vmCount = 0
                autoScale = true
                maxVmCount = 0 // released to zero after each burst (task 5.7)
            }
        }
    }
}