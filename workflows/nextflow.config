/*
 * Executor and container configuration for the secondary-analysis pipeline.
 *
 * Profiles:
 *   standard    (default) - local executor, bin/ scripts run directly.
 *                Demonstrated in this repository's local/containerized scope.
 *   docker      - local executor, containerized per-process execution using
 *                the images built from workflows/containers/*.Dockerfile.
 *                Configuration prepared and validated by `docker build`
 *                (see docs/secondary-pipeline.md); not executed end-to-end
 *                in this sandbox because no container runtime daemon is
 *                available here.
 *   azure_batch - Azure Batch executor profile. Configuration preparation
 *                only: credential-free, relying on Azure managed identity
 *                for storage access, with no storage key or connection
 *                string present in this file. Not exercised against a live
 *                Batch pool in this change.
 *   slurm       - Slurm executor profile for an HPC cluster target.
 *                Configuration preparation only, with no embedded
 *                credentials; Azure Managed Lustre scratch staging is a
 *                separate, not-yet-exercised concern (task 5.3).
 *
 * Batch and Slurm are presented as alternative execution targets with their
 * own applicable conditions, not as a single recommended default (see the
 * secondary-analysis spec's "Neither target is presented as universally
 * preferred" scenario).
 */

manifest {
    name = 'genomics-secondary-analysis'
    description = 'Local/containerized demo secondary-analysis pipeline: QC, alignment, variant calling.'
    version = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled = false
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        includeConfig 'conf/docker.config'
    }

    azure_batch {
        includeConfig 'conf/azure_batch.config'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }
}

env {
    // Nothing in this file or an included profile config may define a
    // storage account key or connection string; storage access for the
    // azure_batch profile is managed-identity only (see conf/azure_batch.config).
    PYTHONDONTWRITEBYTECODE = '1'
}