{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "mode", "status", "iacLanguage", "analyticsEngine", "assets"],
  "properties": {
    "$schema": { "const": "./asset-inventory.schema.json" },
    "schemaVersion": { "const": 1 },
    "mode": { "const": "local-only" },
    "status": { "const": "candidate-awaiting-review" },
    "iacLanguage": { "const": "bicep" },
    "analyticsEngine": { "const": "undecided" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tasks", "dependsOn", "deliverables", "openDecisions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "tasks": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
          },
          "dependsOn": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
          },
          "deliverables": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "openDecisions": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}